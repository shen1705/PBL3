<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewData["Title"] ?? "AZU Car - Thuê xe tự lái")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- Header Navigation -->
    @{
    var reqPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
    var isAboutPage = reqPath.StartsWith("/about");
    var isOwnerPage = reqPath.StartsWith("/become-owner") || reqPath.StartsWith("/owner") || reqPath.StartsWith("/carregistermode");
    var isTripsPage = reqPath.StartsWith("/mytrips") || reqPath.StartsWith("/account");
    var isSupportPage = reqPath.StartsWith("/support");
    var isFindPage = reqPath.StartsWith("/find");
}
    <header class="header">
        <div class="container nav-container">
            <a href="/" class="logo" aria-label="AZU Car - Trang chủ">
                <img src="~/images/logo_transparent.png" alt="AZU Car Logo" class="brand-logo-img">
            </a>
            
            <nav class="nav-links" aria-label="Điều hướng chính">
                <a href="/find" id="find-nav-link" class="nav-find-car-btn"><i class="fa-solid fa-magnifying-glass"></i> Tìm xe</a>
                <a href="/about" id="about-nav-link" class="@(isAboutPage ? "active" : "")">Về AZU Car</a>
                <a href="@(User.IsInRole("Owner") ? "/owner" : "/become-owner")" id="owner-nav-link" class="@(isOwnerPage ? "active" : "")">@(User.IsInRole("Owner") ? "Quản lý xe" : "Trở thành chủ xe")</a>
                <a href="/account#trips" id="trips-nav-link" class="@(isTripsPage ? "active" : "")">Lịch sử thuê</a>
                <a href="/support" id="support-nav-link" class="@(isSupportPage ? "active" : "")">Trợ giúp</a>
                @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                {
                    <a href="/admin/index.html" id="admin-nav-link" style="color: #c49a49; font-weight: 700;"><i class="fa-solid fa-gauge-high"></i> Quản trị</a>
                }
            </nav>

            <div class="nav-actions">
                <div id="guest-actions">
                    <button type="button" class="btn-register-outline">Đăng ký</button>
                    <button type="button" class="btn-slate">Đăng nhập</button>
                </div>

                <!-- User Authenticated Action Center -->
                <div id="user-auth-actions" class="user-auth-actions" style="display:none;">
                    <!-- Notification Center -->
                    <div class="user-notif-wrapper" id="userNotifWrapper">
                        <button type="button" class="user-notif-btn" id="userNotificationBtn" aria-label="Thông báo" aria-expanded="false" title="Thông báo hệ thống">
                            <i class="fa-regular fa-bell"></i>
                            <span class="user-notif-badge" id="userNotifyBadge" style="display:none;">0</span>
                        </button>

                        <div class="user-notif-dropdown" id="userNotifyDropdown" style="display:none;" role="region" aria-label="Trung tâm thông báo">
                            <div class="user-notif-header">
                                <div class="notif-title-wrap">
                                    <span class="notif-title">Thông báo</span>
                                    <span class="notif-unread-pill" id="notifUnreadPill" style="display:none;">0 mới</span>
                                </div>
                                <button type="button" class="notif-action-btn" id="btnMarkAllRead" title="Đánh dấu tất cả đã đọc">
                                    <i class="fa-solid fa-check-double"></i> Đã đọc tất cả
                                </button>
                            </div>

                            <div class="user-notif-list" id="userNotifyList">
                                <div class="notif-loading">
                                    <i class="fa-solid fa-spinner fa-spin"></i> Đang tải thông báo...
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- User Profile Dropdown -->
                    <div class="user-profile-wrapper" id="userProfileWrapper">
                        <button type="button" class="user-profile-trigger" id="userProfileTrigger" aria-label="Menu tài khoản" aria-expanded="false">
                            <span class="account-avatar" id="account-avatar">U</span>
                            <span class="user-profile-name" id="account-name">Người dùng</span>
                            <i class="fa-solid fa-chevron-down user-chevron"></i>
                        </button>

                        <div class="user-profile-dropdown" id="userProfileDropdown" style="display:none;" role="menu">
                            <div class="user-dropdown-header">
                                <div class="user-header-avatar" id="dropdownAvatar">U</div>
                                <div class="user-header-info">
                                    <strong class="user-header-name" id="dropdownUserName">Người dùng</strong>
                                    <span class="user-header-role" id="dropdownUserRole">Khách thuê</span>
                                </div>
                            </div>
                            <div class="user-dropdown-divider"></div>
                            <a href="/account" class="user-dropdown-item" role="menuitem">
                                <i class="fa-regular fa-user"></i>
                                <span>Hồ sơ của tôi</span>
                            </a>
                            <a href="/account#cards" class="user-dropdown-item" role="menuitem">
                                <i class="fa-regular fa-credit-card"></i>
                                <span>Thẻ thanh toán</span>
                            </a>
                            <a href="/account#trips" class="user-dropdown-item" role="menuitem">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                                <span>Lịch sử chuyến</span>
                            </a>
                            <a href="/account#favorites" class="user-dropdown-item" role="menuitem">
                                <i class="fa-regular fa-heart"></i>
                                <span>Xe đã lưu</span>
                            </a>
                            <div class="user-dropdown-divider"></div>
                            <a href="/account#password" class="user-dropdown-item" role="menuitem">
                                <i class="fa-solid fa-key"></i>
                                <span>Đổi mật khẩu</span>
                            </a>
                            <div class="user-dropdown-divider"></div>
                            <button type="button" class="user-dropdown-item is-danger" id="btnUserHeaderLogout" role="menuitem">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                <span>Đăng xuất</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Hidden fallback anchor to preserve legacy references -->
                <a id="account-display" class="account-display" href="/account" aria-label="Thông tin tài khoản" style="display:none !important;" hidden></a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    @RenderBody()

    <!-- Footer -->
    @if (ViewData["HideFooter"] as bool? != true && !isFindPage)
    {
    <footer class="footer" id="support">
        <div class="container footer-grid">
            <div class="footer-col">
                <a href="/" class="logo footer-logo">
                    <img src="~/images/logo_transparent.png" alt="AZU Car Logo" class="brand-logo-img">
                </a>
                <p class="footer-desc">Nền tảng chia sẻ và cho thuê ô tô tự lái hàng đầu Việt Nam. Mang lại những chuyến đi tự do và hạnh phúc cho triệu hành trình.</p>
            </div>
            <div class="footer-col">
                <h4>VỀ AZU CAR</h4>
                <ul>
                    <li><a href="/about">Về chúng tôi</a></li>
                    <li><a href="/about#features">Tính năng</a></li>
                    <li><a href="/account#privacy">Chính sách bảo vệ dữ liệu</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>DỊCH VỤ</h4>
                <ul>
                    <li><a href="/find">Thuê xe tự lái</a></li>
                    <li><a href="/become-owner">Đăng ký chủ xe</a></li>
                    <li><a href="/support">Hỗ trợ khách hàng</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>HỖ TRỢ &amp; LIÊN HỆ</h4>
                <p><strong>Hotline:</strong> 1900 9217 (8:00 - 21:00)</p>
                <p><strong>Email:</strong> support@azucar.vn</p>
                <p><strong>Văn phòng:</strong> Phường Hải Châu, TP. Đà Nẵng</p>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container footer-bottom-flex">
                <p>2026 AZU Car Việt Nam. Bảo lưu mọi quyền lợi.</p>
                <div class="footer-bottom-links">
                    <a href="/account#privacy">Điều khoản dịch vụ</a>
                    <a href="/account#privacy">Chính sách hoạt động</a>
                    <a href="/account#privacy">Quy chế hoạt động</a>
                </div>
            </div>
        </div>
    </footer>
    }

    @if (!reqPath.StartsWith("/chatbot"))
    {
        <!-- Floating AI Chatbot Button -->
        <a href="/chatbot" class="floating-chat-bubble" title="Trò chuyện cùng Trợ lý ảo AZU Car 24/7" aria-label="Trợ lý ảo AZU Car">
            <span class="floating-chat-icon"><i class="fa-solid fa-robot"></i></span>
            <span class="floating-chat-text">Hỗ trợ AI 24/7</span>
            <span class="floating-chat-pulse"></span>
        </a>
    }

    <!-- Shared Modals -->
    <partial name="_Modals" />

    <!-- Scripts -->
    <script src="~/js/azu-store.js" asp-append-version="true"></script>
    <script src="~/js/vehicle-images.js" asp-append-version="true"></script>
    <script src="~/js/dispute-modal.js" asp-append-version="true"></script>
    <script src="~/js/trip-handover-modal.js" asp-append-version="true"></script>
    <script src="~/js/index.js" asp-append-version="true"></script>
    <script src="~/js/user-nav.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

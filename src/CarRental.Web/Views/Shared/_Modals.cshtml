</div>

<!-- Modal Chọn Thời Gian / Lịch Thuê Xe -->
<div id="timeModal" class="auth-modal-overlay">
    <div class="auth-modal-card" style="max-width: 540px; padding: 24px;">
        <button class="modal-close-btn" data-modal="timeModal"><i class="fa-solid fa-xmark"></i></button>
        <div class="modal-header" style="margin-bottom: 16px;">
            <h2 style="font-size: 20px; font-weight: 700; color: #1e293b;">Thời gian thuê</h2>
        </div>
        
        <div style="display: flex; border-bottom: 1px solid #e2e8f0; margin-bottom: 20px; text-align: center;">
            <div id="tabDaily" style="flex: 1; padding-bottom: 10px; font-weight: 700; color: #4e6fca; border-bottom: 2px solid #1d5194; cursor: pointer;">Thuê ngày</div>
            <div id="tabHourly" style="flex: 1; padding-bottom: 10px; font-weight: 600; color: #94a3b8; cursor: pointer;">Thuê giờ</div>
        </div>

        <div id="dailyContent">
            <p class="rental-date-hint">Chọn ngày nhận xe, sau đó chọn ngày trả xe.</p>
            <div class="rental-date-selection">
                <button id="selectPickupDate" class="rental-date-choice active" type="button">
                    <span>Ngày nhận xe</span>
                    <strong id="selectedPickupDate">Chọn ngày</strong>
                </button>
                <button id="selectReturnDate" class="rental-date-choice" type="button">
                    <span>Ngày trả xe</span>
                    <strong id="selectedReturnDate">Chọn ngày</strong>
                </button>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <button id="prevMonthBtn" style="background: #f1f5f9; border: none; border-radius: 50%; width: 32px; height: 32px; cursor: pointer;"><i class="fa-solid fa-chevron-left"></i></button>
                <span id="currentMonthYearLabel" style="font-weight: 700; font-size: 16px; color: #1e293b;">Tháng 10, 2026</span>
                <button id="nextMonthBtn" style="background: #f1f5f9; border: none; border-radius: 50%; width: 32px; height: 32px; cursor: pointer;"><i class="fa-solid fa-chevron-right"></i></button>
            </div>

            <div style="border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; margin-bottom: 16px;">
                <div style="display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; font-size: 12px; color: #64748b; font-weight: 600; margin-bottom: 8px;">
                    <span>T2</span><span>T3</span><span>T4</span><span>T5</span><span>T6</span><span>T7</span><span>CN</span>
                </div>
                <div id="dynamicCalendarDays" style="display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; font-size: 13px; gap: 8px; color: #334155; cursor: pointer;"></div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                <div style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 8px 12px;">
                    <label style="font-size: 11px; font-weight: 700; color: #64748b; display: block; margin-bottom: 2px;">Giờ nhận xe</label>
                    <select id="pickupTimeSelect" style="width: 100%; border: none; font-size: 14px; font-weight: 600; color: #1e293b; outline: none; background: transparent; cursor: pointer;">
                        <option value="09:00" selected>09:00</option>
                        <option value="12:00">12:00</option>
                        <option value="15:00">15:00</option>
                        <option value="18:00">18:00</option>
                        <option value="21:00">21:00</option>
                    </select>
                </div>
                <div style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 8px 12px;">
                    <label style="font-size: 11px; font-weight: 700; color: #64748b; display: block; margin-bottom: 2px;">Giờ trả xe</label>
                    <select id="returnTimeSelect" style="width: 100%; border: none; font-size: 14px; font-weight: 600; color: #1e293b; outline: none; background: transparent; cursor: pointer;">
                        <option value="09:00">09:00</option>
                        <option value="12:00">12:00</option>
                        <option value="15:00">15:00</option>
                        <option value="18:00" selected>18:00</option>
                        <option value="20:00">20:00</option>
                        <option value="21:00">21:00</option>
                    </select>
                </div>
            </div>
        </div>

        <div id="hourlyContent" style="display: none;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                <div style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 8px 12px;">
                    <label style="font-size: 11px; font-weight: 700; color: #64748b; display: block; margin-bottom: 2px;">Ngày bắt đầu</label>
                    <input type="date" id="hourlyDateInput" value="2026-10-14" style="width: 100%; border: none; font-size: 14px; font-weight: 600; color: #1e293b; outline: none; background: transparent; cursor: pointer;">
                </div>
                <div style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 8px 12px;">
                    <label style="font-size: 11px; font-weight: 700; color: #64748b; display: block; margin-bottom: 2px;">Giờ nhận xe</label>
                    <select id="hourlyPickupTime" style="width: 100%; border: none; font-size: 14px; font-weight: 600; color: #1e293b; outline: none; background: transparent; cursor: pointer;">
                        <option value="14:00">14:00</option>
                        <option value="15:00">15:00</option>
                        <option value="16:00" selected>16:00</option>
                        <option value="17:00">17:00</option>
                    </select>
                </div>
            </div>
            <div style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 8px 12px; margin-bottom: 16px;">
                <label style="font-size: 11px; font-weight: 700; color: #64748b; display: block; margin-bottom: 2px;">Thời gian thuê</label>
                <select id="hourlyDuration" style="width: 100%; border: none; font-size: 14px; font-weight: 600; color: #1e293b; outline: none; background: transparent; cursor: pointer;">
                    <option value="2">2 giờ</option>
                    <option value="4" selected>4 giờ</option>
                    <option value="6">6 giờ</option>
                    <option value="8">8 giờ</option>
                </select>
            </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #e2e8f0; padding-top: 16px;">
            <div>
                <div id="modalPreviewText" style="font-weight: 700; font-size: 14px; color: #1e293b;">16:00, 14/10 - 20:00, 14/10</div>
                <div id="modalSubPreviewText" style="font-size: 12px; color: #64748b; margin-top: 2px;">Thời gian thuê: <span style="color: #021254; font-weight: 700;">4 giờ</span></div>
            </div>
            <button id="btnConfirmTime" style="background-color: #021843; color: white; border: none; padding: 10px 24px; border-radius: 8px; font-weight: 700; font-size: 14px; cursor: pointer;">Tiếp tục</button>
        </div>
    </div>
</div>

@{
    var bookingId = ViewData["BookingId"];
    ViewData["Title"] = $"Chi tiết chuyến đi #{bookingId} - AZU Car";
}

<div style="text-align: center; padding: 80px 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
    <i class="fa-solid fa-spinner fa-spin fa-2x" style="color: #2563eb;"></i>
    <p style="margin-top: 14px; font-size: 15px; color: #475569;">Đang chuyển hướng đến chi tiết chuyến đi...</p>
</div>

@section Scripts {
    <script>
        window.location.replace('/account?bookingId=@bookingId#trips');
    </script>
}

@{
    ViewData["Title"] = "Đăng ký xe cho thuê - AZU Car";
}

@section Styles {
    <link rel="stylesheet" href="~/css/carregistermode.css" asp-append-version="true">
}

    <main class="owner-register-main">
        <section class="owner-intro">
            <p class="intro-eyebrow">TRỞ THÀNH CHỦ XE CÙNG AZU CAR</p>
            <h1>Tối ưu thu nhập từ chiếc xe nhàn rỗi của bạn</h1>
            <p class="intro-description">AZU Car giúp bạn kết nối với hàng ngàn khách hàng uy tín tại Việt Nam. Quy trình đăng ký nhanh chóng, bảo hiểm chuyến đi toàn diện và an toàn tuyệt đối.</p>

            <ol class="owner-steps">
                <li>
                    <span class="step-number">1</span>
                    <div><strong>Điền thông tin xe</strong><p>Cung cấp các thông số chính xác gồm hãng xe, mẫu xe, biển số và mức giá cho thuê mong muốn.</p></div>
                </li>
                <li>
                    <span class="step-number">2</span>
                    <div><strong>Đăng tải hình ảnh xe</strong><p>Tải ảnh thực tế ngoại thất, nội thất và giấy tờ xe để kiểm định chất lượng.</p></div>
                </li>
                <li>
                    <span class="step-number">3</span>
                    <div><strong>AZU Car tư vấn chủ xe và duyệt xe</strong><p>Đội ngũ chuyên viên AZU Car liên hệ tư vấn hợp đồng, thẩm định hồ sơ và hỗ trợ kích hoạt.</p></div>
                </li>
                <li>
                    <span class="step-number">4</span>
                    <div><strong>Bắt đầu cho thuê</strong><p>Xe sẵn sàng đón khách, chủ xe toàn quyền quản lý lịch trình và nhận thu nhập tự động.</p></div>
                </li>
            </ol>

            <aside class="insurance-note">
                <span class="insurance-icon"><i class="fa-solid fa-shield-halved"></i></span>
                <div><strong>Bảo hiểm chuyến đi MIC</strong><p>Mọi chuyến thuê qua AZU Car đều được bảo hiểm tự nguyện xe ô tô bảo vệ toàn diện.</p></div>
            </aside>
        </section>

        <section class="register-card" aria-labelledby="register-title">
            <a class="back-link" href="/become-owner" aria-label="Quay lại" title="Quay lại"><i class="fa-solid fa-arrow-left"></i></a>
            <h2 id="register-title">Đăng ký xe</h2>
            <div class="register-illustration" aria-hidden="true">
                <div class="illustration-orbit"></div>
                <div class="document-art">
                    <span class="document-mark"></span>
                    <span></span><span></span><span></span>
                    <div><i class="fa-regular fa-square-check"></i><i class="fa-regular fa-square-check"></i></div>
                </div>
                <div class="car-art"><i class="fa-solid fa-car-side"></i><span class="wheel wheel-left"></span><span class="wheel wheel-right"></span></div>
                <div class="person-art"><i class="fa-solid fa-circle-question"></i><span class="person-head"></span><span class="person-body"></span><span class="person-leg"></span></div>
            </div>
            <p class="register-disclaimer">Bằng việc đăng ký, bạn đồng ý với chính sách chia sẻ xe và điều khoản vận hành minh bạch của hệ thống AZU Car Việt Nam.</p>
            <button class="register-cta" id="start-registration" type="button">Đăng ký xe tự lái</button>
        </section>
    </main>

    <!-- Modal Đăng ký xe -->
    <div class="registration-overlay" id="registration-overlay" hidden>
        <div class="registration-modal-card" role="dialog" aria-modal="true" aria-labelledby="reg-modal-title">
            <button class="registration-close" id="close-registration" type="button" aria-label="Đóng"><i class="fa-solid fa-xmark"></i></button>
            
            <div class="registration-wizard-grid">
                <!-- Stepper -->
                <aside class="reg-stepper-sidebar">
                    <div class="reg-stepper-header">
                        <span class="reg-badge-tag">QUY TRÌNH ĐĂNG KÝ</span>
                        <h3 id="reg-modal-title">Đăng ký xe cho thuê</h3>
                    </div>
                    
                    <nav class="reg-steps-list" aria-label="Các bước đăng ký">
                        <!-- Bước 1 -->
                        <div class="reg-step-item active" data-step="1" role="button" tabindex="0">
                            <div class="reg-step-badge">
                                <i class="fa-regular fa-rectangle-list"></i>
                            </div>
                            <span class="reg-step-label">Thông tin cơ bản xe</span>
                        </div>

                        <!-- Bước 2 -->
                        <div class="reg-step-item" data-step="2" role="button" tabindex="0">
                            <div class="reg-step-badge">
                                <i class="fa-regular fa-image"></i>
                            </div>
                            <span class="reg-step-label">Hình ảnh &amp; Giấy tờ</span>
                        </div>

                        <!-- Bước 3 -->
                        <div class="reg-step-item" data-step="3" role="button" tabindex="0">
                            <div class="reg-step-badge">
                                <i class="fa-solid fa-file-contract"></i>
                            </div>
                            <span class="reg-step-label">Chính sách &amp; Phụ phí</span>
                        </div>

                        <!-- Bước 4 -->
                        <div class="reg-step-item" data-step="4" role="button" tabindex="0">
                            <div class="reg-step-badge">
                                <i class="fa-solid fa-clipboard-check"></i>
                            </div>
                            <span class="reg-step-label">Hoàn tất &amp; Gửi duyệt</span>
                        </div>
                    </nav>

                    <div class="reg-sidebar-support">
                        <i class="fa-solid fa-headset"></i>
                        <div>
                            <strong>Cần hỗ trợ đăng ký?</strong>
                            <p>Hotline: 1900 9217 (8:00 - 21:00)</p>
                        </div>
                    </div>
                </aside>

                <!-- Nội dung bước -->
                <main class="reg-wizard-main">
                    <!-- BƯỚC 1: Điền thông tin xe -->
                    <div class="reg-step-pane active" id="pane-step-1">
                        <div class="pane-header">
                            <h4>Bước 1: Điền thông tin xe</h4>
                            <p>Cung cấp các thông số chính xác để khách hàng dễ dàng tìm kiếm và thuê xe của bạn.</p>
                        </div>
                        <form id="form-step-1">
                            <div class="form-row-2">
                                <div class="form-group">
                                    <label for="reg-owner-name">Họ và tên chủ xe <span class="required">*</span></label>
                                    <input id="reg-owner-name" type="text" placeholder="Nguyễn Văn A" required>
                                </div>
                                <div class="form-group">
                                    <label for="reg-owner-phone">Số điện thoại liên hệ <span class="required">*</span></label>
                                    <input id="reg-owner-phone" type="tel" placeholder="0905 123 456" required>
                                </div>
                            </div>

                            <div class="form-row-2">
                                <div class="form-group">
                                    <label for="reg-car-brand">Hãng xe <span class="required">*</span></label>
                                    <select id="reg-car-brand" required>
                                        <option value="" disabled selected>Chọn hãng xe</option>
                                        <option value="Toyota">Toyota</option>
                                        <option value="Hyundai">Hyundai</option>
                                        <option value="VinFast">VinFast</option>
                                        <option value="Mazda">Mazda</option>
                                        <option value="Honda">Honda</option>
                                        <option value="Kia">Kia</option>
                                        <option value="Ford">Ford</option>
                                        <option value="Mitsubishi">Mitsubishi</option>
                                        <option value="Khác">Hãng khác...</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="reg-car-model">Mẫu xe &amp; Phiên bản <span class="required">*</span></label>
                                    <input id="reg-car-model" type="text" placeholder="Ví dụ: Mazda 3 Luxury" required>
                                </div>
                            </div>

                            <div class="form-row-3">
                                <div class="form-group">
                                    <label for="reg-car-plate">Biển số xe <span class="required">*</span></label>
                                    <input id="reg-car-plate" type="text" placeholder="43A-123.45" required>
                                </div>
                                <div class="form-group">
                                    <label for="reg-car-year">Năm sản xuất</label>
                                    <select id="reg-car-year">
                                        <option value="2026">2026</option>
                                        <option value="2025">2025</option>
                                        <option value="2024" selected>2024</option>
                                        <option value="2023">2023</option>
                                        <option value="2022">2022</option>
                                        <option value="2021">2021</option>
                                        <option value="2020">2020</option>
                                        <option value="2019">Trước 2020</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="reg-car-seats">Số chỗ ngồi</label>
                                    <select id="reg-car-seats">
                                        <option value="4 chỗ">4 chỗ</option>
                                        <option value="5 chỗ" selected>5 chỗ</option>
                                        <option value="7 chỗ">7 chỗ</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-row-2">
                                <div class="form-group">
                                    <label for="reg-car-price">Giá thuê đề xuất (VNĐ / ngày) <span class="required">*</span></label>
                                    <input id="reg-car-price" type="number" min="300000" step="50000" placeholder="600000" value="600000" required>
                                </div>
                                <div class="form-group">
                                    <label for="reg-car-location">Khu vực bàn giao xe <span class="required">*</span></label>
                                    <select id="reg-car-location">
                                        <option value="Hải Châu, TP. Đà Nẵng" selected>Quận Hải Châu, TP. Đà Nẵng</option>
                                        <option value="Sơn Trà, TP. Đà Nẵng">Quận Sơn Trà, TP. Đà Nẵng</option>
                                        <option value="Ngũ Hành Sơn, TP. Đà Nẵng">Quận Ngũ Hành Sơn, TP. Đà Nẵng</option>
                                        <option value="Thanh Khê, TP. Đà Nẵng">Quận Thanh Khê, TP. Đà Nẵng</option>
                                        <option value="Liên Chiểu, TP. Đà Nẵng">Quận Liên Chiểu, TP. Đà Nẵng</option>
                                        <option value="Cẩm Lệ, TP. Đà Nẵng">Quận Cẩm Lệ, TP. Đà Nẵng</option>
                                    </select>
                                </div>
                            </div>

                            <div class="pane-actions">
                                <div></div>
                                <button class="btn-step-next" type="submit">
                                    Tiếp tục: Tải hình ảnh <i class="fa-solid fa-arrow-right"></i>
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- BƯỚC 2: Đăng tải hình ảnh xe -->
                    <div class="reg-step-pane" id="pane-step-2" hidden>
                        <div class="pane-header">
                            <h4>Bước 2: Đăng tải hình ảnh xe</h4>
                            <p>Đăng tải tối thiểu ảnh ngoại thất và nội thất để AZU Car tiến hành kiểm định hồ sơ.</p>
                        </div>

                        <div class="photo-upload-grid">
                            <div class="photo-card" id="slot-front">
                                <div class="photo-preview">
                                    <i class="fa-regular fa-image"></i>
                                    <span>Mặt trước xe</span>
                                </div>
                                <label class="btn-upload">
                                    <i class="fa-solid fa-camera"></i> Chọn ảnh
                                    <input type="file" accept="image/*" class="photo-file-input">
                                </label>
                            </div>
                            <div class="photo-card" id="slot-back">
                                <div class="photo-preview">
                                    <i class="fa-regular fa-image"></i>
                                    <span>Mặt sau xe</span>
                                </div>
                                <label class="btn-upload">
                                    <i class="fa-solid fa-camera"></i> Chọn ảnh
                                    <input type="file" accept="image/*" class="photo-file-input">
                                </label>
                            </div>
                            <div class="photo-card" id="slot-interior">
                                <div class="photo-preview">
                                    <i class="fa-solid fa-gauge-high"></i>
                                    <span>Khoang lái &amp; Ghế ngồi</span>
                                </div>
                                <label class="btn-upload">
                                    <i class="fa-solid fa-camera"></i> Chọn ảnh
                                    <input type="file" accept="image/*" class="photo-file-input">
                                </label>
                            </div>
                            <div class="photo-card" id="slot-doc">
                                <div class="photo-preview">
                                    <i class="fa-regular fa-id-card"></i>
                                    <span>Giấy tờ xe (Đăng kiểm)</span>
                                </div>
                                <label class="btn-upload">
                                    <i class="fa-solid fa-camera"></i> Chọn ảnh
                                    <input type="file" accept="image/*" class="photo-file-input">
                                </label>
                            </div>
                        </div>

                        <div class="photo-tips">
                            <i class="fa-solid fa-lightbulb"></i>
                            <span>Mẹo: Hình ảnh rõ nét chụp ban ngày, xe sạch sẽ giúp hồ sơ duyệt nhanh và tăng 40% tỉ lệ khách thuê.</span>
                        </div>

                        <div class="pane-actions">
                            <button class="btn-step-prev" type="button" data-prev="1">
                                <i class="fa-solid fa-arrow-left"></i> Quay lại
                            </button>
                            <button class="btn-step-next" type="button" id="btn-to-step-3">
                                Tiếp tục: Chính sách &amp; Phụ phí <i class="fa-solid fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>

                    <!-- BƯỚC 3: Thiết lập Chính sách, Phụ phí & Tiện nghi xe -->
                    <div class="reg-step-pane" id="pane-step-3" hidden>
                        <div class="pane-header">
                            <h4>Bước 3: Thiết lập Chính sách, Phụ phí &amp; Tiện nghi</h4>
                            <p>Tùy chỉnh minh bạch quy định thế chấp, phụ phí và trang bị trên xe để hiển thị chính xác trong bài đăng.</p>
                        </div>

                        <form id="form-step-3">
                            <!-- 1. Chính sách thế chấp -->
                            <div class="reg-policy-card">
                                <div class="reg-policy-card-title">
                                    <i class="fa-solid fa-shield-halved" style="color: #00a550;"></i>
                                    <h5>1. Yêu cầu Tài sản thế chấp khi nhận xe</h5>
                                </div>
                                <p class="reg-policy-card-desc">Khách thuê sẽ chuẩn bị tài sản này để giao cho bạn tại thời điểm nhận xe và nhận lại khi hoàn tất chuyến.</p>
                                
                                <div class="form-group" style="margin-bottom: 12px;">
                                    <label for="reg-collateral-type">Hình thức yêu cầu thế chấp <span class="required">*</span></label>
                                    <select id="reg-collateral-type" required>
                                        <option value="none" selected>Miễn thế chấp (Khách không cần đặt cọc tiền mặt hoặc xe máy)</option>
                                        <option value="bike_or_cash">Xe máy chính chủ (kèm cà vẹt gốc) HOẶC 15.000.000 đ tiền mặt</option>
                                        <option value="cash_only">Tiền mặt ký quỹ (15.000.000 đ)</option>
                                        <option value="custom">Quy định thế chấp riêng...</option>
                                    </select>
                                </div>

                                <div class="form-group" id="reg-collateral-custom-wrap" style="display: none;">
                                    <label for="reg-collateral-custom-text">Nội dung quy định thế chấp riêng <span class="required">*</span></label>
                                    <input id="reg-collateral-custom-text" type="text" placeholder="Ví dụ: Xe máy trị giá > 20 triệu hoặc 20.000.000 đ">
                                </div>
                            </div>

                            <!-- 2. Giới hạn quãng đường & Phụ phí -->
                            <div class="reg-policy-card" style="margin-top: 18px;">
                                <div class="reg-policy-card-title">
                                    <i class="fa-solid fa-receipt" style="color: #00a550;"></i>
                                    <h5>2. Giới hạn quãng đường &amp; Bảng phụ phí phát sinh</h5>
                                </div>
                                <p class="reg-policy-card-desc">Thiết lập biểu phí phát sinh khi khách trả xe quá giờ, vượt quãng đường hoặc làm bẩn xe.</p>

                                <div class="form-row-2">
                                    <div class="form-group">
                                        <label for="reg-fee-limit-km">Giới hạn quãng đường (km / ngày)</label>
                                        <input id="reg-fee-limit-km" type="number" min="100" max="1000" step="50" value="300" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="reg-fee-limit-cost">Phí vượt giới hạn (VNĐ / km)</label>
                                        <input id="reg-fee-limit-cost" type="number" min="1000" max="20000" step="500" value="3000" required>
                                    </div>
                                </div>

                                <div class="form-row-3">
                                    <div class="form-group">
                                        <label for="reg-fee-overtime">Phí quá giờ (VNĐ / giờ)</label>
                                        <input id="reg-fee-overtime" type="number" min="20000" max="300000" step="10000" value="70000" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="reg-fee-clean">Phí vệ sinh xe bẩn (VNĐ)</label>
                                        <input id="reg-fee-clean" type="number" min="30000" max="300000" step="10000" value="80000" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="reg-fee-deodor">Phí khử mùi hôi/hút thuốc (VNĐ)</label>
                                        <input id="reg-fee-deodor" type="number" min="100000" max="1000000" step="50000" value="500000" required>
                                    </div>
                                </div>
                            </div>

                            <!-- 3. Tiện nghi trang bị trên xe -->
                            <div class="reg-policy-card" style="margin-top: 18px;">
                                <div class="reg-policy-card-title">
                                    <i class="fa-solid fa-wand-magic-sparkles" style="color: #00a550;"></i>
                                    <h5>3. Tiện nghi &amp; Trang bị trên xe</h5>
                                </div>
                                <p class="reg-policy-card-desc">Tích chọn các trang thiết bị thực tế đang có sẵn trên chiếc xe của bạn:</p>

                                <div class="amenities-checkbox-grid">
                                    <label class="amenity-checkbox-label">
                                        <input type="checkbox" name="amenity" value="Bản đồ" checked>
                                        <span><i class="fa-solid fa-map-location-dot"></i> Bản đồ dẫn đường</span>
                                    </label>
                                    <label class="amenity-checkbox-label">
                                        <input type="checkbox" name="amenity" value="Bluetooth" checked>
                                        <span><i class="fa-brands fa-bluetooth-b"></i> Bluetooth</span>
                                    </label>
                                    <label class="amenity-checkbox-label">
                                        <input type="checkbox" name="amenity" value="Camera lùi" checked>
                                        <span><i class="fa-solid fa-camera"></i> Camera lùi</span>
                                    </label>
                                    <label class="amenity-checkbox-label">
                                        <input type="checkbox" name="amenity" value="Camera hành trình" checked>
                                        <span><i class="fa-solid fa-video"></i> Camera hành trình</span>
                                    </label>
                                    <label class="amenity-checkbox-label">
                                        <input type="checkbox" name="amenity" value="Cảm biến va chạm" checked>
                                        <span><i class="fa-solid fa-satellite-dish"></i> Cảm biến va chạm</span>
                                    </label>
                                    <label class="amenity-checkbox-label">
                                        <input type="checkbox" name="amenity" value="Định vị GPS" checked>
                                        <span><i class="fa-solid fa-location-crosshairs"></i> Định vị GPS</span>
                                    </label>
                                    <label class="amenity-checkbox-label">
                                        <input type="checkbox" name="amenity" value="Ghế trẻ em">
                                        <span><i class="fa-solid fa-child"></i> Ghế trẻ em</span>
                                    </label>
                                    <label class="amenity-checkbox-label">
                                        <input type="checkbox" name="amenity" value="Khe cắm USB" checked>
                                        <span><i class="fa-solid fa-usb"></i> Khe cắm USB</span>
                                    </label>
                                    <label class="amenity-checkbox-label">
                                        <input type="checkbox" name="amenity" value="Túi khí an toàn" checked>
                                        <span><i class="fa-solid fa-shield-heart"></i> Túi khí an toàn</span>
                                    </label>
                                    <label class="amenity-checkbox-label">
                                        <input type="checkbox" name="amenity" value="Cửa sổ trời">
                                        <span><i class="fa-solid fa-sun"></i> Cửa sổ trời</span>
                                    </label>
                                </div>
                            </div>

                            <!-- 4. Điều khoản riêng của chủ xe -->
                            <div class="reg-policy-card" style="margin-top: 18px;">
                                <div class="reg-policy-card-title">
                                    <i class="fa-solid fa-gavel" style="color: #00a550;"></i>
                                    <h5>4. Quy định &amp; Điều khoản riêng của bạn</h5>
                                </div>
                                <p class="reg-policy-card-desc">Các yêu cầu riêng biệt mà khách thuê bắt buộc phải tuân thủ (mỗi dòng một điều khoản):</p>
                                
                                <div class="form-group">
                                    <textarea id="reg-custom-terms" rows="4" placeholder="Nhập các điều khoản riêng...">• Sử dụng xe đúng mục đích, không vi phạm pháp luật giao thông.
• Nghiêm cấm hút thuốc lá, thuốc lá điện tử hoặc xả rác bừa bãi trong khoang xe.
• Không vận chuyển hàng cấm, vũ khí, chất cháy nổ hoặc động vật, thực phẩm có mùi tanh.
• Vui lòng giữ gìn xe sạch sẽ và hoàn trả đúng hẹn theo hợp đồng.</textarea>
                                </div>
                            </div>

                            <div class="pane-actions" style="margin-top: 24px;">
                                <button class="btn-step-prev" type="button" data-prev="2">
                                    <i class="fa-solid fa-arrow-left"></i> Quay lại
                                </button>
                                <button class="btn-step-next" type="button" id="btn-submit-registration">
                                    Gửi hồ sơ đăng ký xe <i class="fa-solid fa-paper-plane"></i>
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- BƯỚC 4: Kết quả gửi duyệt & Thẩm định -->
                    <div class="reg-step-pane" id="pane-step-4" hidden>
                        <div class="review-status-card">
                            <div class="status-pulse-circle">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                            </div>
                            <h4>Hồ sơ đăng ký xe đã được gửi thành công!</h4>
                            <p class="review-lead">Đội ngũ AZU Car đang tiến hành thẩm định thông tin và biểu phí của xe để hiển thị công khai trên ứng dụng.</p>

                            <div class="review-summary-box">
                                <div class="summary-item">
                                    <span class="summary-label">Mẫu xe đăng ký:</span>
                                    <strong id="summary-car-name">Mazda 3 Luxury 2024</strong>
                                </div>
                                <div class="summary-item">
                                    <span class="summary-label">Biển số:</span>
                                    <strong id="summary-car-plate">43A-123.45</strong>
                                </div>
                                <div class="summary-item">
                                    <span class="summary-label">Chủ xe:</span>
                                    <strong id="summary-owner-name">Nguyễn Văn A</strong>
                                </div>
                                <div class="summary-item">
                                    <span class="summary-label">Thế chấp áp dụng:</span>
                                    <strong id="summary-collateral">Miễn thế chấp</strong>
                                </div>
                                <div class="summary-item">
                                    <span class="summary-label">Trạng thái hồ sơ:</span>
                                    <span class="status-badge-pending"><i class="fa-solid fa-spinner fa-spin"></i> Chờ duyệt (Pending)</span>
                                </div>
                            </div>

                            <div class="review-checklist">
                                <div class="check-row done">
                                    <i class="fa-solid fa-circle-check"></i>
                                    <span>Tiếp nhận thông tin xe, hình ảnh kiểm định &amp; chính sách phụ phí</span>
                                </div>
                                <div class="check-row pending">
                                    <i class="fa-regular fa-clock"></i>
                                    <span>Chuyên viên AZU Car liên hệ tư vấn hợp đồng &amp; thiết bị định vị trong 24h</span>
                                </div>
                                <div class="check-row">
                                    <i class="fa-regular fa-circle"></i>
                                    <span>Kích hoạt gói bảo hiểm chuyến đi MIC toàn diện &amp; đưa xe lên sàn</span>
                                </div>
                            </div>

                            <div class="pane-actions center-actions">
                                <a href="/become-owner#danh-sach-xe-content" class="btn-finish-reg">
                                    <i class="fa-solid fa-car"></i> Đến trang Quản lý xe của tôi
                                </a>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </div>

@section Scripts {

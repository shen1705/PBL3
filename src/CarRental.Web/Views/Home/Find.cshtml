                            </div>
                            <div class="time-col">
                                <span class="time-label">TRẢ XE</span>
                                <strong class="time-val" id="widgetReturnTime">21:00, 16/10/2026</strong>
                            </div>
                        </div>
                        <p class="hourly-support-text"><i class="fa-solid fa-bolt"></i> Chủ xe hỗ trợ thuê xe theo giờ. <a href="#">Tìm hiểu thêm</a></p>

                        <!-- Địa điểm giao nhận xe -->
                        <div class="delivery-options-group">
                            <label class="delivery-radio-label">
                                <input type="radio" name="deliveryOption" value="pickup" checked>
                                <div class="delivery-radio-content">
                                    <div class="delivery-row">
                                        <span>Tự đến lấy xe</span>
                                        <strong class="text-free">Miễn phí</strong>
                                    </div>
                                    <small id="widgetCarLocShort">Phường Hòa Thuận Tây, Quận Hải Châu</small>
                                </div>
                            </label>

                            <label class="delivery-radio-label">
                                <input type="radio" name="deliveryOption" value="delivery">
                                <div class="delivery-radio-content">
                                    <div class="delivery-row">
                                        <span>Nhận &amp; trả xe tận nơi</span>
                                        <strong class="delivery-fee-val">15.000đ</strong>
                                    </div>
                                    <small id="widgetDeliveryAddr">Đà Nẵng • 1km &gt;</small>
                                </div>
                            </label>
                        </div>

                        <!-- Bảng chi tiết giá -->
                        <div class="pricing-breakdown">
                            <div class="price-row">
                                <span>Đơn giá thuê <i class="fa-regular fa-circle-question"></i></span>
                                <strong id="calcBasePrice">524.000đ /ngày</strong>
                            </div>
                            <div class="price-row">
                                <span>Bảo hiểm thuê xe <i class="fa-regular fa-circle-question"></i></span>
                                <strong id="calcInsurancePrice">66.501đ /ngày</strong>
                            </div>
                            <div class="price-row" id="rowPassengerInsurance">
                                <span>Bảo hiểm người trên xe</span>
                                <strong>30.000đ /ngày</strong>
                            </div>
                            <div class="price-row">
                                <span>Phí giao nhận xe <i class="fa-regular fa-circle-question"></i></span>
                                <strong id="calcDeliveryFee">Miễn phí</strong>
                            </div>
                            <div class="price-divider"></div>
                            <div class="price-total-row">
                                <span>Thành tiền</span>
                                <strong class="total-number" id="calcTotalPrice">620.501đ</strong>
                            </div>
                        </div>

                        <!-- Nút Chọn thuê -->
                        <button type="button" class="btn-rent-now" id="btnRentCarSubmit">CHỌN THUÊ</button>
                    </div>

                    <!-- Box Phụ phí có thể phát sinh -->
                    <div class="side-panel-box extra-fees-box">
                        <h4>Phụ phí có thể phát sinh</h4>
                        <div class="extra-fee-item">
                            <div class="fee-name">Phí vượt giới hạn <i class="fa-regular fa-circle-question"></i></div>
                            <div class="fee-desc">Phụ phí phát sinh nếu lộ trình di chuyển vượt quá 300km/ngày.</div>
                            <strong class="fee-cost">3.000đ/km</strong>
                        </div>
                        <div class="extra-fee-item">
                            <div class="fee-name">Phí quá giờ <i class="fa-regular fa-circle-question"></i></div>
                            <div class="fee-desc">Phụ phí phát sinh khi hoàn trả xe trễ giờ. Thuê thêm 1 ngày nếu trễ quá 5 giờ.</div>
                            <strong class="fee-cost">70.000đ/giờ</strong>
                        </div>
                        <div class="extra-fee-item">
                            <div class="fee-name">Phí vệ sinh <i class="fa-regular fa-circle-question"></i></div>
                            <div class="fee-desc">Phụ phí phát sinh khi xe không được vệ sinh sạch sẽ khi hoàn trả.</div>
                            <strong class="fee-cost">80.000đ</strong>
                        </div>
                        <div class="extra-fee-item">
                            <div class="fee-name">Phí khử mùi <i class="fa-regular fa-circle-question"></i></div>
                            <div class="fee-desc">Phụ phí phát sinh khi xe có mùi khó chịu do hút thuốc, thực phẩm nặng mùi.</div>
                            <strong class="fee-cost">500.000đ</strong>
                        </div>
                        <div class="extra-fee-item">
                            <div class="fee-name">Phí sạc pin / xăng</div>
                            <div class="fee-desc">Khách thuê vui lòng hoàn trả xe với mức pin/xăng tương đương khi nhận xe.</div>
                            <strong class="fee-cost">Đơn giá sạc + 20.000đ/lần</strong>
                        </div>

                        <div class="report-car-row">
                            <a href="#" class="report-link"><i class="fa-regular fa-flag"></i> Báo cáo xe này</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Điền Thông Tin Đặt Xe (Booking Checkout Form) -->
    <div class="booking-overlay" id="bookingModal" hidden>
        <div class="booking-dialog" role="dialog" aria-modal="true" aria-labelledby="bookingModalTitle">
            <button class="booking-close" id="closeBookingModal" type="button" aria-label="Đóng"><i class="fa-solid fa-xmark"></i></button>
            
            <div class="booking-header">
                <span class="booking-tag"><i class="fa-solid fa-file-signature"></i> THỦ TỤC THUÊ XE</span>
                <h3 id="bookingModalTitle">Xác nhận thông tin đặt xe</h3>
                <p>Vui lòng điền thông tin liên hệ và hình thức nhận xe để chủ xe chuẩn bị bàn giao.</p>
            </div>

            <form id="bookingCheckoutForm" class="booking-form-grid">
                <!-- Cột trái: Nhập thông tin -->
                <div class="booking-fields-col">
                    <!-- Phần 1: Thông tin người thuê -->
                    <div class="booking-section-card">
                        <h4 class="section-card-title"><i class="fa-solid fa-user-check"></i> Thông tin khách thuê</h4>
                        <div class="form-row-2">
                            <div class="booking-group">
                                <label for="bookRenterName">Họ và tên khách thuê <span class="req">*</span></label>
                                <input id="bookRenterName" type="text" placeholder="Nguyễn Văn A" required>
                            </div>
                            <div class="booking-group">
                                <label for="bookRenterPhone">Số điện thoại liên hệ <span class="req">*</span></label>
                                <input id="bookRenterPhone" type="tel" placeholder="0905 123 456" required>
                            </div>
                        </div>

                        <div class="form-row-2">
                            <div class="booking-group">
                                <label for="bookRenterEmail">Email nhận vé &amp; hợp đồng <span class="req">*</span></label>
                                <input id="bookRenterEmail" type="email" placeholder="example@email.com" required>
                            </div>
                            <div class="booking-group">
                                <label for="bookRenterId">Số CCCD / Hộ chiếu <span class="req">*</span></label>
                                <input id="bookRenterId" type="text" placeholder="048202001234" required>
                            </div>
                        </div>
                    </div>

                    <!-- Phần 2: Hình thức nhận xe -->
                    <div class="booking-section-card">
                        <h4 class="section-card-title"><i class="fa-solid fa-location-dot"></i> Hình thức &amp; Địa điểm nhận xe</h4>
                        <div class="delivery-options">
                            <label class="delivery-radio-label active" id="labelPickHost">
                                <input type="radio" name="deliveryMethod" value="host" checked>
                                <div class="radio-content">
                                    <div class="radio-title"><i class="fa-solid fa-store"></i> Nhận xe tại vị trí của chủ xe</div>
                                    <div class="radio-desc" id="bookHostLocation">Phường Hải Châu, TP. Đà Nẵng (Miễn phí)</div>
                                </div>
                            </label>
                            <label class="delivery-radio-label" id="labelPickDelivery">
                                <input type="radio" name="deliveryMethod" value="delivery">
                                <div class="radio-content">
                                    <div class="radio-title"><i class="fa-solid fa-truck-ramp-box"></i> Giao xe tận nơi</div>
                                    <div class="radio-desc">Giao tại sân bay, khách sạn hoặc địa chỉ riêng</div>
                                </div>
                            </label>
                        </div>

                        <div class="booking-group delivery-address-wrap" id="deliveryAddressGroup" hidden>
                            <label for="bookDeliveryAddress">Địa chỉ bạn muốn nhận xe <span class="req">*</span></label>
                            <input id="bookDeliveryAddress" type="text" placeholder="Ví dụ: Sân bay Đà Nẵng, Khách sạn Novotel...">
                        </div>

                        <div class="booking-group">
                            <label for="bookRenterNotes">Ghi chú cho chủ xe (Tùy chọn)</label>
                            <textarea id="bookRenterNotes" rows="2" placeholder="Ví dụ: Hạ cánh lúc 9h30, cần hỗ trợ thêm ghế trẻ em..."></textarea>
                        </div>
                    </div>

                    <!-- Phần 3: Phương thức thanh toán -->
                    <div class="booking-section-card">
                        <h4 class="section-card-title"><i class="fa-solid fa-credit-card"></i> Phương thức thanh toán</h4>
                        <div class="payment-methods-grid">
                            <label class="payment-radio-label active">
                                <input type="radio" name="paymentMethod" value="qr" checked>
                                <span><i class="fa-solid fa-qrcode"></i> Chuyển khoản QR / VNPAY</span>
                            </label>
                            <label class="payment-radio-label">
                                <input type="radio" name="paymentMethod" value="card">
                                <span><i class="fa-solid fa-credit-card"></i> Thẻ Visa / Mastercard</span>
                            </label>
                            <label class="payment-radio-label">
                                <input type="radio" name="paymentMethod" value="cash">
                                <span><i class="fa-solid fa-hand-holding-dollar"></i> Thanh toán khi nhận bàn giao xe</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Cột phải: Tóm tắt đơn đặt xe -->
                <div class="booking-summary-col">
                    <div class="booking-car-summary-box">
                        <div class="summary-car-card">
                            <img id="bookCarThumb" src="" alt="Xe đã chọn">
                            <div class="summary-car-info">
                                <span class="car-badge-pill">ĐẶT NHANH</span>
                                <h4 id="bookCarTitle">Tên xe</h4>
                                <p id="bookCarLocation"><i class="fa-solid fa-location-dot"></i> Địa chỉ xe</p>
                            </div>
                        </div>

                        <div class="summary-divider"></div>

                        <div class="summary-time-block">
                            <div class="time-col">
                                <span class="time-lbl">NHẬN XE</span>
                                <strong id="bookPickupTime">09:00, 15/10/2026</strong>
                            </div>
                            <div class="time-arrow"><i class="fa-solid fa-arrow-right"></i></div>
                            <div class="time-col">
                                <span class="time-lbl">TRẢ XE</span>
                                <strong id="bookReturnTime">18:00, 18/10/2026</strong>
                            </div>
                        </div>

                        <div class="summary-divider"></div>

                        <div class="summary-price-table">
                            <div class="sum-row">
                                <span>Đơn giá thuê</span>
                                <strong id="bookBasePrice">0đ</strong>
                            </div>
                            <div class="sum-row">
                                <span>Bảo hiểm thuê xe</span>
                                <strong id="bookInsurancePrice">0đ</strong>
                            </div>
                            <div class="sum-row">
                                <span>Bảo hiểm người trên xe</span>
                                <strong id="bookPassengerInsurance">30.000đ/ngày</strong>
                            </div>
                            <div class="sum-row">
                                <span>Phí giao nhận</span>
                                <strong id="bookDeliveryFee">Miễn phí</strong>
                            </div>
                            <div class="summary-divider"></div>
                            <div class="sum-total-row">
                                <span>Thành tiền</span>
                                <strong class="total-number" id="bookTotalPrice">0đ</strong>
                            </div>
                        </div>

                        <div class="summary-shield-note">
                            <i class="fa-solid fa-shield-halved"></i>
                            <div>
                                <strong>Bảo hiểm tự nguyện MIC</strong>
                                <p>Bảo vệ toàn diện trước sự cố trong suốt hành trình.</p>
                            </div>
                        </div>

                        <div class="booking-actions-wrap">
                            <button type="submit" class="btn-confirm-booking" id="btnConfirmBooking">
                                <i class="fa-solid fa-circle-check"></i> Xác nhận đặt xe
                            </button>
                            <button type="button" class="btn-back-to-car" id="btnBackToCar">
                                <i class="fa-solid fa-arrow-left"></i> Quay lại
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

@section Scripts {
    <script src="~/js/find.js" asp-append-version="true"></script>
}

@{
    ViewData["Title"] = "Tìm kiếm xe tự lái - AZU Car";
}

@section Styles {
    <link rel="stylesheet" href="~/css/find.css" asp-append-version="true">
}

    <!-- Sub-header Search & Filter Bar -->
    <section class="search-filter-bar">
        <div class="container bar-content">
            <button class="btn-back" type="button" aria-label="Quay lại" title="Quay lại"><i class="fa-solid fa-arrow-left"></i></button>
            
            <div class="filter-location-box" id="openLocationModal" role="button" tabindex="0">
                <i class="fa-solid fa-location-dot"></i>
                <span class="filter-label">Địa điểm</span>
                <strong id="filterLocationText">TP. Đà Nẵng</strong>
            </div>

            <div class="filter-time-box" id="openTimeModal" role="button" tabindex="0">
                <i class="fa-regular fa-calendar-days"></i>
                <span class="filter-label">Thời gian thuê</span>
                <strong id="filterTimeText">21:00, 27/3/2025 – 21:00, 29/3/2025</strong>
                <span id="pickupTimeText" hidden>21:00, 27/03/2025</span>
                <span id="returnTimeText" hidden>21:00, 29/03/2025</span>
            </div>

            <button class="btn-search-action" id="btnSearchAction" type="button"><i class="fa-solid fa-magnifying-glass"></i> <span>Tìm kiếm</span></button>
            <button class="btn-filter-action" id="openFilterModalBtn" type="button"><i class="fa-solid fa-sliders"></i> <span>Bộ lọc</span></button>
        </div>
    </section>

    <!-- Quick Category Badges Bar -->
    <section class="category-pills-bar">
        <div class="container pills-content">
            <!-- Dropdown Loại xe -->
            <div class="pill-dropdown-wrap" id="pillCarTypeWrap">
                <button class="pill-btn" id="pillBtnCarType" type="button" aria-expanded="false">
                    <i class="fa-solid fa-car"></i>
                    <span id="pillCarTypeText">Loại xe</span>
                    <i class="fa-solid fa-chevron-down pill-chevron"></i>
                </button>
                <div class="pill-dropdown-menu" id="pillCarTypeMenu" hidden>
                    <button type="button" class="pill-dropdown-item active" data-type="all">Tất cả loại xe</button>
                    <button type="button" class="pill-dropdown-item" data-type="4-seats">4 - 5 chỗ</button>
                    <button type="button" class="pill-dropdown-item" data-type="7-seats">7 chỗ</button>
                    <button type="button" class="pill-dropdown-item" data-type="sedan">Sedan</button>
                    <button type="button" class="pill-dropdown-item" data-type="suv">SUV </button>
                    <button type="button" class="pill-dropdown-item" data-type="mpv">MPV đa dụng</button>
                    <button type="button" class="pill-dropdown-item" data-type="pickup">Bán tải</button>
                    <button type="button" class="pill-dropdown-item" data-type="electric">Xe điện</button>
                </div>
            </div>

            <!-- Dropdown Hãng xe -->
            <div class="pill-dropdown-wrap" id="pillCarBrandWrap">
                <button class="pill-btn" id="pillBtnCarBrand" type="button" aria-expanded="false">
                    <i class="fa-solid fa-tag"></i>
                    <span id="pillCarBrandText">Hãng xe</span>
                    <i class="fa-solid fa-chevron-down pill-chevron"></i>
                </button>
                <div class="pill-dropdown-menu" id="pillCarBrandMenu" hidden>
                    <button type="button" class="pill-dropdown-item active" data-brand="all">Tất cả hãng</button>
                    <button type="button" class="pill-dropdown-item" data-brand="toyota">Toyota</button>
                    <button type="button" class="pill-dropdown-item" data-brand="hyundai">Hyundai</button>
                    <button type="button" class="pill-dropdown-item" data-brand="vinfast">VinFast</button>
                    <button type="button" class="pill-dropdown-item" data-brand="mazda">Mazda</button>
                    <button type="button" class="pill-dropdown-item" data-brand="honda">Honda</button>
                    <button type="button" class="pill-dropdown-item" data-brand="kia">Kia</button>
                    <button type="button" class="pill-dropdown-item" data-brand="ford">Ford</button>
                    <button type="button" class="pill-dropdown-item" data-brand="mitsubishi">Mitsubishi</button>
                    <button type="button" class="pill-dropdown-item" data-brand="other">Khác (Suzuki, Nissan...)</button>
                </div>
            </div>

            <!-- Nút Toggle Đặt xe nhanh -->
            <button class="pill-btn" id="pillBtnInstant" type="button">
                <i class="fa-solid fa-bolt"></i>
                <span>Đặt xe nhanh</span>
            </button>
        </div>
    </section>

    <!-- Main Results Section -->
    <main class="main-results-section">
        <div class="container">
            <div class="results-header">
                <h2 id="resultsLocationHeading">Xe tự lái tại TP. Đà Nẵng</h2>
                <div class="results-meta">
                    <span class="count-text" id="carCountText">Tìm thấy 17 xe phù hợp với chuyến đi của bạn</span>
                    <span id="sampleDataNote" class="sample-data-note" hidden>Dữ liệu xe ở Hà Nội và TP. Hồ Chí Minh là dữ liệu minh họa.</span>
                    <div class="sort-dropdown-box">
                        <span>Sắp xếp:</span>
                        <select id="sortSelect">
                            <option value="best">Giá tốt nhất</option>
                            <option value="popular">Phổ biến nhất</option>
                            <option value="price-asc">Giá thấp đến cao</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Grid Thẻ Xe (Tải động từ CSDL qua /api/vehicles) -->
            <div class="cars-grid" id="carsGrid">
                <div class="loading-cars" style="grid-column: 1 / -1; text-align: center; padding: 48px; color: #64748b;">
                    <i class="fa-solid fa-spinner fa-spin fa-2x" style="color: #00a550;"></i>
                    <p style="margin-top: 12px; font-weight: 500;">Đang kết nối cơ sở dữ liệu và tải danh sách xe...</p>
                </div>
            </div>
            <p id="noCarsMessage" class="no-cars-message" hidden>Hiện chưa có xe tại địa điểm này.</p>
        </div>
    </main>

    <!-- Modal Đăng nhập -->
    <div id="loginModal" class="auth-modal-overlay">
        <div class="auth-modal-card">
            <button class="modal-close-btn" data-modal="loginModal"><i class="fa-solid fa-xmark"></i></button>
            <div class="modal-header">
                <h2>Đăng nhập</h2>
                <p>Chào mừng quý khách quay lại với AZUCar</p>
            </div>
            <form class="auth-form" id="login-form">
                <div class="form-group">
                    <label for="login-identity">Tên hoặc số điện thoại</label>
                    <div class="input-wrapper">
                        <input id="login-identity" name="identity" type="text" placeholder="Nhập tên hoặc số điện thoại" autocomplete="username" required>
                    </div>
                </div>
                <div class="form-group">
                    <label for="login-password">Mật khẩu</label>
                    <div class="input-wrapper password-box">
                        <input id="login-password" name="password" type="password" placeholder="Nhập mật khẩu" autocomplete="current-password" required>
                        <i class="fa-regular fa-eye-slash toggle-password"></i>
                    </div>
                    <div class="forgot-password-row">
                        <a href="#" class="forgot-link" id="openForgotModal">Quên mật khẩu?</a>
                    </div>
                </div>
                <button type="submit" class="btn-submit-auth">Đăng nhập</button>
                <p class="switch-auth-text">Bạn chưa là thành viên? <a href="#" id="switchToRegister">Đăng ký ngay</a></p>
            </form>
        </div>
    </div>

    <!-- Modal Quên mật khẩu -->
    <div id="forgotModal" class="auth-modal-overlay">
        <div class="auth-modal-card">
            <button class="modal-close-btn" data-modal="forgotModal"><i class="fa-solid fa-xmark"></i></button>
            
            <!-- Bước 1: Nhập Số điện thoại / Email -->
            <div id="forgotStep1">
                <div class="modal-header">
                    <h2>Khôi phục mật khẩu</h2>
                    <p>Nhập số điện thoại hoặc email liên kết để nhận mã xác thực OTP</p>
                </div>
                <form class="auth-form" id="forgot-form-step1">
                    <div class="form-group">
                        <label for="forgot-identity">Số điện thoại hoặc Email</label>
                        <div class="input-wrapper">
                            <input id="forgot-identity" name="identity" type="text" placeholder="Ví dụ: 0905 123 456 hoặc email@gmail.com" required>
                        </div>
                    </div>
                    <button type="submit" class="btn-submit-auth">Gửi mã xác thực OTP</button>
                    <p class="switch-auth-text">Nhớ mật khẩu? <a href="#" class="back-to-login-link">Đăng nhập ngay</a></p>
                </form>
            </div>

            <!-- Bước 2: Nhập OTP & Mật khẩu mới -->
            <div id="forgotStep2" hidden>
                <div class="modal-header">
                    <h2>Đặt lại mật khẩu</h2>
                    <p>Mã OTP 6 số đã được gửi tới <strong id="forgotTargetText" style="color: #1c2635;">0905***456</strong></p>
                </div>
                <form class="auth-form" id="forgot-form-step2">
                    <div class="form-group">
                        <label for="forgot-otp">Mã xác thực OTP</label>
                        <div class="input-wrapper">
                            <input id="forgot-otp" name="otp" type="text" maxlength="6" placeholder="Nhập 6 số OTP (mặc định: 123456)" required style="letter-spacing: 4px; font-weight: 700; text-align: center; font-size: 16px;">
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 6px; font-size: 12px;">
                            <span style="color: #64748b;">Chưa nhận được mã?</span>
                            <button type="button" id="btnResendOtp" style="background: none; border: none; color: #d1a34b; font-weight: 600; cursor: pointer; padding: 0;">Gửi lại mã (<span id="otpCountdown">59</span>s)</button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="forgot-new-password">Mật khẩu mới</label>
                        <div class="input-wrapper password-box">
                            <input id="forgot-new-password" name="newPassword" type="password" placeholder="Tạo mật khẩu mới (ít nhất 6 ký tự)" autocomplete="new-password" required>
                            <i class="fa-regular fa-eye-slash toggle-password"></i>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="forgot-confirm-password">Xác nhận mật khẩu mới</label>
                        <div class="input-wrapper password-box">
                            <input id="forgot-confirm-password" name="confirmPassword" type="password" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" required>
                            <i class="fa-regular fa-eye-slash toggle-password"></i>
                        </div>
                    </div>

                    <button type="submit" class="btn-submit-auth">Xác nhận &amp; Đăng nhập</button>
                    <p class="switch-auth-text"><a href="#" id="backToStep1Forgot">← Thay đổi số điện thoại / email</a></p>
                </form>
            </div>

            <!-- Bước 3: Thông báo thành công -->
            <div id="forgotStepSuccess" hidden style="text-align: center; padding: 16px 0 8px;">
                <div style="width: 60px; height: 60px; border-radius: 50%; background: #eef4fa; color: #1c2635; display: inline-flex; align-items: center; justify-content: center; font-size: 26px; margin-bottom: 16px; border: 2px solid #b8cce4;">
                    <i class="fa-solid fa-check"></i>
                </div>
                <h3 style="font-size: 18px; color: #1c2635; margin: 0 0 8px;">Đổi mật khẩu thành công!</h3>
                <p style="font-size: 13.5px; color: #64748b; margin: 0 0 20px; line-height: 1.5;">Mật khẩu mới của bạn đã được cập nhật an toàn vào hệ thống AZU Car.</p>
                <button type="button" class="btn-submit-auth" id="btnGoToLoginAfterReset" style="margin: 0 auto; width: 100%;">Đăng nhập ngay</button>
            </div>
        </div>
    </div>

    <!-- Modal Đăng ký -->
    <div id="registerModal" class="auth-modal-overlay">
        <div class="auth-modal-card">
            <button class="modal-close-btn" data-modal="registerModal"><i class="fa-solid fa-xmark"></i></button>
            <div class="modal-header">
                <h2>Đăng ký</h2>
                <p>Chào mừng quý khách đến với AZUCar</p>
            </div>
            <form class="auth-form" id="register-form">
                <div class="form-group">
                    <label for="register-name">Tên tài khoản</label>
                    <div class="input-wrapper">
                        <input id="register-name" name="name" type="text" placeholder="Nhập tên tài khoản" autocomplete="name" required>
                    </div>
                </div>
                <div class="form-group">
                    <label for="register-phone">Số điện thoại</label>
                    <div class="input-wrapper">
                        <input id="register-phone" name="phone" type="tel" placeholder="Nhập số điện thoại của bạn" autocomplete="tel" required>
                    </div>
                </div>
                <div class="form-group">
                    <label for="register-password">Mật khẩu</label>
                    <div class="input-wrapper password-box">
                        <input id="register-password" name="password" type="password" placeholder="Nhập mật khẩu" autocomplete="new-password" required>
                        <i class="fa-regular fa-eye-slash toggle-password"></i>
                    </div>
                </div>
                <div class="form-group">
                    <label for="register-password-confirm">Nhập lại mật khẩu</label>
                    <div class="input-wrapper password-box">
                        <input id="register-password-confirm" name="passwordConfirm" type="password" placeholder="Nhập lại mật khẩu" autocomplete="new-password" required>
                        <i class="fa-regular fa-eye-slash toggle-password"></i>
                    </div>
                </div>
                <div class="form-group">
                    <label>Nhập mã giới thiệu (nếu có)</label>
                    <div class="input-wrapper">
                        <input type="text" placeholder="Nhập mã">
                    </div>
                </div>
                <p class="terms-text">Tôi đã đọc và đồng ý với <a href="/account#privacy" class="open-policy-link" data-policy="terms">Chính sách & Quy định</a> và <a href="/account#privacy" class="open-policy-link" data-policy="privacy">Chính sách Bảo vệ dữ liệu cá nhân</a></p>
                <button type="submit" class="btn-submit-auth">Đăng ký</button>
                <p class="switch-auth-text">Bạn đã có tài khoản? <a href="#" id="switchToLogin">Đăng nhập ngay</a></p>
            </form>
        </div>
    </div>

    <!-- Modal Xem Chính Sách & Quy Định / Bảo Vệ Dữ Liệu Cá Nhân -->
    <div id="policyPreviewModal" class="auth-modal-overlay policy-modal-overlay" style="z-index: 100000;" hidden>
        <div class="auth-modal-card policy-modal-card" role="dialog" aria-modal="true" aria-labelledby="policyModalTitle">
            <button class="modal-close-btn" id="closePolicyModalBtn" type="button" aria-label="Đóng"><i class="fa-solid fa-xmark"></i></button>
            
            <div class="policy-modal-header">
                <span class="policy-modal-badge" id="policyModalBadge"><i class="fa-solid fa-shield-halved"></i> QUY CHUẨN AN TOÀN</span>
                <h2 id="policyModalTitle">CHÍNH SÁCH & QUY ĐỊNH</h2>
                <p id="policyModalSubtitle">Điều khoản sử dụng dịch vụ và quy chế vận hành AZU Car Việt Nam</p>
                
                <!-- Tab chuyển nhanh giữa 2 chính sách -->
                <div class="policy-modal-tabs" role="tablist">
                    <button type="button" class="policy-tab-btn active" id="tabBtnTerms" data-policy="terms">
                        <i class="fa-solid fa-file-contract"></i> Chính sách & Quy định
                    </button>
                    <button type="button" class="policy-tab-btn" id="tabBtnPrivacy" data-policy="privacy">
                        <i class="fa-solid fa-user-shield"></i> Bảo vệ dữ liệu cá nhân
                    </button>
                </div>
            </div>

            <div class="policy-modal-body" id="policyModalBody">
                <!-- Nội dung được nạp động từ JS -->
            </div>

            <div class="policy-modal-footer">
                <button type="button" class="policy-btn-print" id="btnPrintPolicy" onclick="window.print()">
                    <i class="fa-solid fa-print"></i> In / Tải PDF
                </button>
                <button type="button" class="btn-submit-auth policy-btn-agree" id="btnAcceptPolicy">
                    <i class="fa-solid fa-circle-check"></i> Đã hiểu & Đồng ý
                </button>
            </div>
        </div>
    </div>

    <!-- Popup chọn địa điểm -->
    <div id="locationModal" class="location-picker-overlay">
        <div class="location-picker-panel" role="dialog" aria-modal="true" aria-labelledby="locationModalTitle">
            <div class="location-picker-header">
                <div>
                    <h2 id="locationModalTitle">Chọn địa điểm</h2>
                    <p>Chọn nơi bạn muốn nhận xe</p>
                </div>
                <button class="location-picker-close" data-modal="locationModal" type="button" aria-label="Đóng">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="location-current">
                <i class="fa-solid fa-location-dot"></i>
                <div>
                    <span>Địa điểm hiện tại</span>
                    <strong id="locationCurrentText">TP. Đà Nẵng</strong>
                </div>
            </div>
            <label class="location-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input id="locationInput" type="text" placeholder="Tìm thành phố hoặc khu vực">
            </label>
            <div class="location-list-title">Địa điểm đang có xe</div>
            <div id="locationOptions" class="location-options"></div>
            <button id="confirmLocationBtn" class="location-custom-confirm" type="button" hidden>
                Dùng địa điểm đã nhập
            </button>
        </div>
    </div>

    <!-- Popup chọn thời gian thuê -->
    <div id="timeModal" class="auth-modal-overlay">
        <div class="auth-modal-card" style="max-width: 540px; padding: 24px;">
            <button class="modal-close-btn" data-modal="timeModal" type="button" aria-label="Đóng"><i class="fa-solid fa-xmark"></i></button>
            <div class="modal-header" style="margin-bottom: 16px;">
                <h2 style="font-size: 20px; font-weight: 700; color: #1e293b;">Thời gian thuê</h2>
            </div>
            <div style="display: flex; border-bottom: 1px solid #e2e8f0; margin-bottom: 20px; text-align: center;">
                <div id="tabDaily" style="flex: 1; padding-bottom: 10px; font-weight: 700; color: #00a550; border-bottom: 2px solid #00a550; cursor: pointer;">Thuê ngày</div>
                <div id="tabHourly" style="flex: 1; padding-bottom: 10px; font-weight: 600; color: #94a3b8; cursor: pointer;">Thuê giờ</div>
            </div>
            <div id="dailyContent">
                <p class="rental-date-hint" style="color: #64748b; font-size: 13px; margin-bottom: 12px;">Chọn ngày nhận xe, sau đó chọn ngày trả xe.</p>
                <div class="rental-date-selection" style="display: flex; gap: 12px; margin-bottom: 16px;">
                    <button id="selectPickupDate" class="rental-date-choice active" type="button" style="flex: 1; padding: 10px 14px; border: 1px solid #00a550; border-radius: 8px; background: #f0fdf4; text-align: left; cursor: pointer;">
                        <span style="display: block; font-size: 11px; color: #64748b;">Ngày nhận xe</span>
                        <strong id="selectedPickupDate" style="display: block; font-size: 14px; color: #00a550;">Chọn ngày</strong>
                    </button>
                    <button id="selectReturnDate" class="rental-date-choice" type="button" style="flex: 1; padding: 10px 14px; border: 1px solid #e2e8f0; border-radius: 8px; background: #fff; text-align: left; cursor: pointer;">
                        <span style="display: block; font-size: 11px; color: #64748b;">Ngày trả xe</span>
                        <strong id="selectedReturnDate" style="display: block; font-size: 14px; color: #1e293b;">Chọn ngày</strong>
                    </button>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <button id="prevMonthBtn" type="button" style="background: #f1f5f9; border: none; border-radius: 50%; width: 32px; height: 32px; cursor: pointer;"><i class="fa-solid fa-chevron-left"></i></button>
                    <span id="currentMonthYearLabel" style="font-weight: 700; font-size: 16px; color: #1e293b;">Tháng 10, 2026</span>
                    <button id="nextMonthBtn" type="button" style="background: #f1f5f9; border: none; border-radius: 50%; width: 32px; height: 32px; cursor: pointer;"><i class="fa-solid fa-chevron-right"></i></button>
                </div>
                <div style="border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; margin-bottom: 16px;">
                    <div style="display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; font-size: 12px; color: #64748b; font-weight: 600; margin-bottom: 8px;">
                        <span>T2</span><span>T3</span><span>T4</span><span>T5</span><span>T6</span><span>T7</span><span>CN</span>
                    </div>
                    <div id="dynamicCalendarDays" style="display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; font-size: 13px; gap: 8px; color: #334155; cursor: pointer;"></div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                    <div style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 8px 12px;">
                        <label style="font-size: 11px; font-weight: 700; color: #64748b; display: block; margin-bottom: 2px;">Giờ nhận xe</label>
                        <select id="pickupTimeSelect" style="width: 100%; border: none; font-size: 14px; font-weight: 600; color: #1e293b; outline: none; background: transparent; cursor: pointer;">
                            <option value="09:00">09:00</option><option value="12:00">12:00</option><option value="15:00">15:00</option><option value="18:00">18:00</option><option value="21:00" selected>21:00</option>
                        </select>
                    </div>
                    <div style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 8px 12px;">
                        <label style="font-size: 11px; font-weight: 700; color: #64748b; display: block; margin-bottom: 2px;">Giờ trả xe</label>
                        <select id="returnTimeSelect" style="width: 100%; border: none; font-size: 14px; font-weight: 600; color: #1e293b; outline: none; background: transparent; cursor: pointer;">

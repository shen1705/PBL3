@{
    ViewData["Title"] = "Trợ lý ảo AZU Car - Chatbot 24/7";
}

@section Styles {
    <link rel="stylesheet" href="~/css/support.css" asp-append-version="true">
}

<main class="support-shell">
    <div class="container support-container">
        <!-- Page Heading with Back Arrow -->
        <div class="support-page-heading">
            <a href="/support" class="btn-back" aria-label="Quay lại mục Trò chuyện" title="Quay lại">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <h1 class="page-title">Trợ lý ảo AZU Car</h1>
        </div>

        <!-- Chatbot Card -->
        <div class="support-main-card chatbot-page-card">
            <!-- Chat Header -->
            <div class="chat-header">
                <div class="bot-info">
                    <div class="bot-avatar">
                        <i class="fa-solid fa-robot"></i>
                        <span class="status-dot online" title="Trực tuyến 24/7"></span>
                    </div>
                    <div class="bot-text">
                        <h2 class="bot-name">AZU Assistant <span class="ai-badge">AI 24/7</span></h2>
                        <p class="bot-status"><i class="fa-solid fa-circle"></i> Trực tuyến 24/7 • Sẵn sàng giải đáp</p>
                    </div>
                </div>
                <button type="button" class="btn-reset-chat" id="btnResetChat" title="Làm mới cuộc trò chuyện" aria-label="Làm mới cuộc trò chuyện">
                    <i class="fa-solid fa-rotate-right"></i>
                    <span>Làm mới</span>
                </button>
            </div>

            <!-- Chat Messages Stream -->
            <div class="chat-messages-stream" id="chatMessagesStream" aria-live="polite">
                <!-- Bot Greeting Message -->
                <div class="message-row bot-row">
                    <div class="msg-avatar bot-avatar-mini">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <div class="msg-bubble bot-bubble">
                        <p><strong>Xin chào! Tôi là Trợ lý ảo AZU Car 🚗</strong></p>
                        <p>Tôi có thể giúp bạn giải đáp ngay mọi thông tin về:</p>
                        <ul>
                            <li>Thủ tục &amp; giấy tờ nhận xe tự lái (GPLX, CCCD/VNeID)</li>
                            <li>Tiền cọc thế chấp &amp; các phương thức thanh toán</li>
                            <li>Chính sách bảo hiểm vật chất &amp; quy trình xử lý va chạm</li>
                            <li>Chính sách hủy chuyến &amp; đăng ký xe cho thuê</li>
                        </ul>
                        <p>Hãy chọn nhanh câu hỏi gợi ý bên dưới hoặc gửi thắc mắc của bạn nhé!</p>
                    </div>
                </div>

                <!-- Quick Prompt Suggestion Chips -->
                <div class="chat-prompt-chips" id="chatPromptChips">
                    <button type="button" class="prompt-chip" data-prompt="Thủ tục thuê xe cần những giấy tờ gì?">
                        <i class="fa-solid fa-id-card"></i> Thủ tục thuê xe gồm những gì?
                    </button>
                    <button type="button" class="prompt-chip" data-prompt="Thuê xe có cần đặt cọc tiền mặt hoặc xe máy không?">
                        <i class="fa-solid fa-money-bill-wave"></i> Có cần đặt cọc tiền mặt không?
                    </button>
                    <button type="button" class="prompt-chip" data-prompt="Chính sách hủy chuyến và hoàn tiền cọc ra sao?">
                        <i class="fa-solid fa-calendar-xmark"></i> Chính sách hủy chuyến &amp; hoàn cọc?
                    </button>
                    <button type="button" class="prompt-chip" data-prompt="Nếu xảy ra va chạm hoặc tai nạn thì xử lý thế nào?">
                        <i class="fa-solid fa-shield-halved"></i> Xử lý khi có va chạm/sự cố?
                    </button>
                    <button type="button" class="prompt-chip" data-prompt="Làm thế nào để đăng ký xe của tôi cho thuê trên AZU Car?">
                        <i class="fa-solid fa-key"></i> Đăng ký xe cho thuê như thế nào?
                    </button>
                </div>
            </div>

            <!-- Typing Indicator -->
            <div class="typing-indicator" id="typingIndicator" hidden>
                <div class="msg-avatar bot-avatar-mini">
                    <i class="fa-solid fa-robot"></i>
                </div>
                <div class="typing-dots">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
                <span class="typing-label">AZU Assistant đang soạn câu trả lời...</span>
            </div>

            <!-- Chat Input Bar -->
            <form class="chat-input-area" id="chatForm" autocomplete="off">
                <div class="input-box-wrapper">
                    <input type="text" id="chatInputText" placeholder="Nhập câu hỏi của bạn (ví dụ: Giấy tờ thuê xe gồm những gì?)..." required>
                    <button type="submit" class="btn-send-msg" id="btnSendMsg" aria-label="Gửi tin nhắn">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </div>
            </form>
        </div>

        <!-- Hotline Support Footer Note -->
        <div class="support-footer-note">
            <i class="fa-solid fa-phone"></i>
            <span>Cần hỗ trợ khẩn cấp trên đường? Hotline 24/7: <a href="tel:19009217"><strong>1900 9217</strong></a> • Email: <a href="mailto:support@azucar.vn">support@azucar.vn</a></span>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/chatbot.js" asp-append-version="true"></script>
}

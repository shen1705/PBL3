## .NET / Visual Studio / VS Code .gitignore

# Build results
bin/
obj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Visual Studio files
.vs/
*.user
*.userosscache
*.suo
*.userprefs

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Rider
.idea/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# ASP.NET Core secrets / environment-specific configs (chứa connection string thật)
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json
*.pfx

# EF Core
efbin/

# Database files (nếu dùng LocalDB/SQLite khi dev)
*.mdf
*.ldf
*.ndf
*.db
*.sqlite

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Node (nếu dùng npm cho frontend assets)
node_modules/

# Publish output
[Pp]ublish/
*.publish.xml
*.pubxml
*.azurePubxml

# Misc
*.log
*.tmp
*.bak
*.swp

# Documentation vault: share only the reviewed minimal settings
**/.obsidian*/
!/docs/.obsidian/
/docs/.obsidian/*
!/docs/.obsidian/app.json
/docs/.trash/
/docs/report/exports/
# Code Runner temporary files
tempCodeRunnerFile.*

# Local uploaded images/documents (CCCD, GPLX, Vehicle Docs, Disputes)
**/wwwroot/uploads/*
!**/wwwroot/uploads/.gitkeep

# Environment variables (API keys, secrets)
.env
*.env